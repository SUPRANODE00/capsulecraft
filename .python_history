import math

class ENUConverter:
    # WGS-84 Ellipsoid constants
    A = 6378137.0          # Semi-major axis (meters)
    F = 1 / 298.257223563  # Flattening
    E2 = F * (2 - F)       # First eccentricity squared

    def __init__(self, lat0: float, lon0: float, h0: float):
        """
        Initialize the local tangent plane origin (0,0,0).
        Lat/Lon provided in decimal degrees, height in meters.
        """
        self.lat0_rad = math.radians(lat0)
        self.lon0_rad = math.radians(lon0)
        self.h0 = h0
        
        # Calculate origin ECEF coordinates
        self.x0, self.y0, self.z0 = self.geodetic_to_ecef(self.lat0_rad, self.lon0_rad, self.h0)

    @classmethod
    def geodetic_to_ecef(cls, lat_rad: float, lon_rad: float, h: float):
        """Converts geodetic coordinates (radians) to ECEF (X, Y, Z meters)."""
        sin_lat = math.sin(lat_rad)
        cos_lat = math.cos(lat_rad)
        sin_lon = math.sin(lon_rad)
        cos_lon = math.cos(lon_rad)

        # Prime vertical radius of curvature
        N = cls.A / math.sqrt(1 - cls.E2 * sin_lat**2)

        X = (N + h) * cos_lat * cos_lon
        Y = (N + h) * cos_lat * sin_lon
        Z = (N * (1 - cls.E2) + h) * sin_lat
        return X, Y, Z

    def ecef_to_enu(self, X: float, Y: float, Z: float):
        """Rotates ECEF delta vector into local ENU frame (East, North, Up meters)."""
        dX = X - self.x0
        dY = Y - self.y0
        dZ = Z - self.z0

        sin_lat0 = math.sin(self.lat0_rad)
        cos_lat0 = math.cos(self.lat0_rad)
        sin_lon0 = math.sin(self.lon0_rad)
        cos_lon0 = math.cos(self.lon0_rad)

        # Rotation matrix transform
        e = -sin_lon0 * dX + cos_lon0 * dY
        n = -sin_lat0 * cos_lon0 * dX - sin_lat0 * sin_lon0 * dY + cos_lat0 * dZ
        u =  cos_lat0 * cos_lon0 * dX + cos_lat0 * sin_lon0 * dY + sin_lat0 * dZ

        return e, n, u

    def geodetic_to_enu(self, lat: float, lon: float, h: float):
        """Direct conversion from target lat/lon/h to local ENU (m)."""
        lat_rad = math.radians(lat)
        lon_rad = math.radians(lon)
        X, Y, Z = self.geodetic_to_ecef(lat_rad, lon_rad, h)
        return self.ecef_to_enu(X, Y, Z)


